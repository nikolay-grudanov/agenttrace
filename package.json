{
  "name": "@grudanov-nikolay/opencode-workshop",
  "version": "0.0.1",
  "description": "Local-first trace debugger for AI agents — Kolya's fork of @raindrop/workshop. Installable via npm on Linux x64 and Windows x64; ships pre-compiled Bun binaries (no Bun required at runtime). Distributed as the `raindrop` CLI.",
  "main": "bin/raindrop.js",
  "bin": {
    "raindrop": "bin/raindrop.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "bin/",
    "binaries/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/embed-migrations.ts --check && bun x tsc --noEmit && bun run build:ui",
    "build:ui": "cd app && bun x vite build",
    "build:bun": "bun scripts/build-bun.ts",
    "build:bun:linux": "bun scripts/build-bun.ts --target=bun-linux-x64",
    "build:bun:windows": "bun scripts/build-bun.ts --target=bun-windows-x64",
    "build:bun:stage": "bun scripts/build-bun.ts --target=bun-linux-x64 && mv build/bun/raindrop-bun-linux-x64 binaries/raindrop-linux-x64 && bun scripts/build-bun.ts --target=bun-windows-x64 && mv build/bun/raindrop-bun-windows-x64.exe binaries/raindrop-windows-x64.exe",
    "dev": "bun run link-dev && bun --watch src/index.ts workshop serve & (printf \"\\nVite UI: http://localhost:${RAINDROP_WORKSHOP_UI_PORT:-5900}\\n\\n\" && cd app && bun x vite --force) & wait",
    "link-dev": "ln -sf ../bin/raindrop-dev node_modules/.bin/raindrop-dev",
    "postinstall": "bun run link-dev",
    "dev:server": "bun --watch src/index.ts workshop serve",
    "dev:ui": "cd app && bun x vite --force",
    "dev:examples": "bun scripts/dev-all.ts",
    "db:generate": "drizzle-kit generate && bun scripts/embed-migrations.ts",
    "db:embed": "bun scripts/embed-migrations.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "setup": "bash .devin/setup.sh",
    "seed:traces": "bun scripts/seed-traces.ts",
    "start": "bun src/index.ts workshop serve",
    "test": "bun test tests/",
    "test:watch": "bun test tests/ --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "manifest": "bun scripts/generate-manifest.ts",
    "install:local": "bun scripts/install-local.ts",
    "prepublishOnly": "bun run build:bun:stage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.26",
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agent-install": "^0.0.5",
    "ai": "^6.0.160",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "ink": "^7.0.2",
    "jsonpath-plus": "^10.4.0",
    "markdown-it": "^14.1.1",
    "protobufjs": "~7.5.3",
    "raindrop-ai": "^0.0.89",
    "react": "^19.2.6",
    "tar": "^7",
    "ws": "^8.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/markdown-it": "^14.1.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "1.60.0",
    "react-devtools-core": "^6.1.2",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.0"
  },
  "workspaces": [
    "app"
  ],
  "author": "Nikolai Grudanov <nikolay-grudanov@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/nikolay-grudanov/opencode-workshop",
  "bugs": {
    "url": "https://github.com/nikolay-grudanov/opencode-workshop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolay-grudanov/opencode-workshop.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
